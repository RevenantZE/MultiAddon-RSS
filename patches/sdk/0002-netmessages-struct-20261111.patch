diff --git a/public/networksystem/inetworkserializer.h b/public/networksystem/inetworkserializer.h
index bdb0251..a85fd9c 100644
--- a/public/networksystem/inetworkserializer.h
+++ b/public/networksystem/inetworkserializer.h
@@ -44,44 +44,47 @@ typedef uint16 NetworkMessageId;
 typedef uint8 NetworkGroupId;
 typedef uint NetworkCategoryId;
 
+// Since the 2026-11-11 CS2 update (2000943) a registered net message is this plain 0x28 byte struct instead of a
+// polymorphic CNetworkSerializerPB. INetworkMessages::FindOrCreateNetMessage allocates and fills it, and
+// INetworkMessages::GetNetMessageInfo returns the pointer it is given, so the info and the message are the same object.
 struct NetMessageInfo_t
 {
-	int m_nCategories;
-	IProtobufBinding *m_pBinding;
+	CUtlString m_szName;
+	// Allocates a CNetMessagePB of this message type (operator new); free it with delete
+	CNetMessage *( *m_pfnAllocateMessage )();
 	CUtlString m_szGroup;
+	// int32 in the engine; message ids fit in NetworkMessageId
 	NetworkMessageId m_MessageId;
-	NetworkGroupId m_GroupId;
+	int m_nCategories;
 
-	// (1 << 0) - FLAG_RELIABLE
-	// (1 << 6) - FLAG_AUTOASSIGNEDID
-	// (1 << 7) - FLAG_UNK001
-	uint8 m_nFlags;
+	// AssociateNetMessageWithChannelCategoryAbstract ORs the category bit into it too when its bool is true
+	int m_nRequiredHandlerCategories;
+	NetworkGroupId m_GroupId;
 
-	int m_unk001;
-	int m_unk002;
-	bool m_bOkayToRedispatch;
+	NetChannelBufType_t m_nBufType : 5;
+	// Set by FindOrCreateNetMessage's bCannotBeNetworked; Serialize rejects the message and its id is auto-assigned
+	bool m_bCannotBeNetworked : 1;
+	// The bool template argument of the game's CNetMessagePB
+	bool m_bOkayToRedispatch : 1;
+	// Set when the message was registered without a signon group (-1)
+	bool m_bNoSignonGroup : 1;
 };
+static_assert( sizeof( NetMessageInfo_t ) == 0x28, "NetMessageInfo_t layout changed" );
 
